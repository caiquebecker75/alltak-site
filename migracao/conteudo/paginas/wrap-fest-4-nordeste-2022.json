='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-3.jpeg\" title=\"wrap-fest-alltak-fotos-3\">\n\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1067\" height=\"600\" src=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-3.jpeg\" srcset=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-3.jpeg 479w, https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-3.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-64756\" />\n\t\t\t\t\t<span class=\"et_overlay\"></span>\n\t\t\t\t</a>\n\t\t\t\t</div></div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_0_23\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-2.jpeg\" title=\"wrap-fest-alltak-fotos-2\">\n\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1067\" height=\"600\" src=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-2.jpeg\" srcset=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-2.jpeg 479w, https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-2.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-64755\" />\n\t\t\t\t\t<span class=\"et_overlay\"></span>\n\t\t\t\t</a>\n\t\t\t\t</div></div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_0_24\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-1.jpeg\" title=\"wrap-fest-alltak-fotos-1\">\n\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"906\" height=\"600\" src=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-1.jpeg\" srcset=\"https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-1.jpeg 479w, https://alltak.com.br/wp-content/uploads/2021/01/wrap-fest-alltak-fotos-1.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-64754\" />\n\t\t\t\t\t<span class=\"et_overlay\"></span>\n\t\t\t\t</a>\n\t\t\t\t</div></div></div></div>\n\t\t\t</div><div class=\"et_pb_column et_pb_column_1_2 et_pb_column_2  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_0  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><h2>Alltak promove a quarta edição de seu Wrap Fest</h2></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_1  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>A Alltak vai organizar no dia treze de fevereiro, das 10h às 17h30, a quarta edição do Wrap Fest. O evento começou em 2018 e já entrou no calendário dos amantes de carros envelopados como o maior encontro do Brasil nesse estilo.</p>\n<p>O evento acontecerá em paralelo ao evento “Campeonato Mundial EXPOR” na Arena das Dunas, Avenida Prudente de Morais, 5121, Lagoa Nova, Natal, RN. Haverá demonstração de envelopamento ao vivo, distribuição de brindes e adesivos, além da Tenda Alltak para que os participantes conheçam as opções de materiais e tudo sobre o segmento.</p>\n<p>“Os encontros de amantes de carros acontecem há muitos anos em todo o Brasil. Automóveis antigos, reuniões exclusivas para alguns modelos, estilos e tendências aproximam aqueles que têm algo em comum em seus veículos. Então, por que não um encontro para reunir os proprietários de carros envelopados do Brasil? Essa também é uma grande tendência em ascensão por aqui, e como a Alltak trabalha com esse segmento, decidimos organizar o Wrap Fest”, reforça Marcelo Souss, diretor da Alltak e responsável pelo Wrap Fest.</p>\n<p>Então prepare sua máquina, faça sua inscrição, convide os seus amigos e cola com a gente. Vamos colorir as ruas com mais veículos envelopados e mostrar a força da customização automotiva!</p>\n<p>Seja qual for seu estilo, se está envelopado cola com a gente!</p>\n<p>Quem desejar expor o seu veículo envelopado preencha o formulário abaixo, vamos liberar para aos 30 trinta primeiros inscritos, isenção do pagamento da taxa– Vagas limitadas!</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_2  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Data: 13/02/2022 (Domingo)</p>\n<p>Onde: Arena das Dunas, Avenida Prudente de Morais, 5121, Lagoa Nova, Natal, RN</p>\n<p>Horário: 10h00 – 17h30</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_divider et_pb_divider_0 et_pb_divider_position_center et_pb_space\"><div class=\"et_pb_divider_internal\"></div></div><div class=\"et_pb_module et_pb_text et_pb_text_3  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p><strong>Para visitar Acesse:</strong></p></div>\n\t\t\t</div><div class=\"et_pb_button_module_wrapper et_pb_button_0_wrapper et_pb_button_alignment_left et_pb_module \">\n\t\t\t\t<a class=\"et_pb_button et_pb_button_0 et_pb_bg_layout_light\" href=\"https://www.sympla.com.br/evento/campeonato-mundial-expor/1411515\" target=\"_blank\" rel=\"noopener\">VISITAR</a>\n\t\t\t</div><div class=\"et_pb_module et_pb_divider et_pb_divider_1 et_pb_divider_position_center et_pb_space\"><div class=\"et_pb_divider_internal\"></div></div><div class=\"et_pb_module et_pb_text et_pb_text_4  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p><b>Para Expor o seu carro Envelopado</b></p></div>\n\t\t\t</div><div class=\"et_pb_button_module_wrapper et_pb_button_1_wrapper et_pb_button_alignment_left et_pb_module \">\n\t\t\t\t<a class=\"et_pb_button et_pb_button_1 et_pb_bg_layout_light\" href=\"https://forms.gle/iS7CC4rUvyqf5Mk48\" target=\"_blank\" rel=\"noopener\">EXPOSITOR</a>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\t\t</div>\n\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\n\t\t\t\t</article>\n\n\t\t\t\n\n</div>\n\n\t"
